#%RAML 1.0 DataType

type: object
properties:
  student_id:
    type: string
    required: true
  student_name:
    type: string
    required: true
  course_type:
    type: string
    required: true
  course_fee:
    type: number
    required: true
  duration: 
    type: number
    required: true

example:
  {
  "student_id" : "STU-12345",
  "student_name" : "Sri",
  "course_type" : "Mulesoft",
  "course_fee": 20000,
  "duration": 90
  }

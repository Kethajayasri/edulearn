#%RAML 1.0 ResourceType
get:
  description: to retrieve/get the course details of a student enrolled

  responses:
    200:
      body:
        application/json:
          example:
            {
              "student_id": "STU-12345",
              "course_id": "MULE-12345",
              "student_name": "Sri",
              "course_type": "Mulesoft",
              "course_fee": 20000,
              "duration": 50
            }

put:
  description: To update the course details 
  body:
    application/json:
      example:
        {
         "student_id": "STU-12345",
              "course_id": "JAVA-12345",
              "student_name": "Shree",
              "course_type": "JAVA",
              "course_fee": 30000,
              "duration": 60 
        }
  responses:
    200:
      body:
        application/json:
          example:
            {
              "course_id": "JAVA-12345",
              "message": "course info updated successfully"
            }

patch:
  description: 
  body:
    application/json:
      example:
        {
          "course_fee": 40000
        }
  responses:
    200:
      body:
        application/json:
          example:
            {
              "course_id": "JAVA-13456",
              "message": "Specific course details updated successfully"
            }

delete:
  description: To remove the enrollment of specific course
  
  responses:
    200:
        body:
            application/json:
                example:
                    {
                      "course_id": "MULE-12345",
                      "message": "course enrolled is closed successfully"
                    }  
    
      